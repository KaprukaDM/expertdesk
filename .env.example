DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Demo sign-in accounts seeded by `npm run db:seed`.
# Customer -> role CUSTOMER -> /dashboard ; Agency -> role ADMIN -> /admin
DEMO_CUSTOMER1_EMAIL="customer1@demo.test"
DEMO_CUSTOMER1_PASSWORD=""
DEMO_CUSTOMER2_EMAIL="customer2@demo.test"
DEMO_CUSTOMER2_PASSWORD=""
DEMO_AGENCY_EMAIL="agency@kapruka.com"
DEMO_AGENCY_PASSWORD=""

# Model alias for the Claude CLI agent calls (research agent + expert audits).
CLAUDE_AGENT_MODEL="sonnet"

# Hard cost ceiling per individual claude CLI call (see src/lib/agents/runClaudeAgent.ts).
CLAUDE_AGENT_MAX_BUDGET_USD="0.50"

# Optional: override the resolved claude CLI binary path. Leave blank to auto-detect
# (see src/lib/agents/resolveClaudeBinary.ts). Only needed if auto-detection fails.
CLAUDE_CLI_PATH=""
